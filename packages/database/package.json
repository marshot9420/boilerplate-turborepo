{
  "name": "@repo/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": "./src/client.ts",
    "./content": "./src/content/index.ts",
    "./errors": "./src/errors/index.ts",
    "./script-client": "./src/script-client.ts",
    "./transaction": "./src/transaction.ts",
    "./user": "./src/user/index.ts",
    "./user-oauth-account": "./src/user-oauth-account/index.ts",
    "./user-session": "./src/user-session/index.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf node_modules .turbo",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest --config vitest.integration.config.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:test:push": "NODE_ENV=test prisma db push",
    "db:test:generate": "NODE_ENV=test prisma generate",
    "db:test:migrate": "NODE_ENV=test prisma migrate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "catalog:",
    "@repo/core": "workspace:*",
    "@repo/env": "workspace:*",
    "dotenv": "catalog:",
    "pg": "^8.21.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/pg": "^8.20.0",
    "eslint": "catalog:",
    "prisma": "catalog:",
    "typescript": "catalog:"
  }
}
