# App
WEB_APP_URL="http://localhost:3000"
ADMIN_APP_URL="http://localhost:3001"

# Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/boilerplate_turborepo_test"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/boilerplate_turborepo_test"

# Auth
AUTH_SESSION_COOKIE_NAME="boilerplate_session"
AUTH_SESSION_MAX_AGE_SECONDS=2592000

# Google OAuth
GOOGLE_CLIENT_ID="test-google-client-id"
GOOGLE_CLIENT_SECRET="test-google-client-secret"

# Naver OAuth
NAVER_CLIENT_ID="test-naver-client-id"
NAVER_CLIENT_SECRET="test-naver-client-secret"

# Kakao OAuth
KAKAO_CLIENT_ID="test-kakao-client-id"
KAKAO_CLIENT_SECRET="test-kakao-client-secret"

# Mailer
MAIL_PROVIDER="console"
MAIL_FROM="Test <test@example.com>"
